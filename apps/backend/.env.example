# ── DATABASE ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/mcom_links
DIRECT_URL=postgresql://user:password@localhost:5432/mcom_links

# ── AUTH ──────────────────────────────────────────────────────────────────
# JWT signing secret (generate a strong random value, e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me
PORT=3000

# ── MCOM ECOSYSTEM (Central Connectivity) ──────────────────────────────────
# Central Base URL (Local: http://localhost:3010 | Staging: https://staging.auth.mcomsolutions.com | Prod: https://auth.mcomsolutions.com)
MCOM_SOLUTIONS_URL=https://auth.mcomsolutions.com

# Your Platform Identifier (registered in MCOM Console, e.g. 'mall', 'vcard', 'loyalty')
MCOM_PLATFORM_SLUG=mcom-links

# Security credentials generated from the MCOM Solutions Console Admin
# 1. Authorizes MCOM Solutions when it calls your /system/plans endpoints
MCOM_SOLUTION_API_KEY=key_shared_system_api_key_here
# 2. OAuth2 client credentials for SSO user sessions (also seeds the token encryption key)
MCOM_CLIENT_ID=mcom-links
MCOM_CLIENT_SECRET=sec_oauth_client_secret_here
# 3. Verifies HMAC signatures of inbound lifecycle webhooks from Central
MCOM_WEBHOOK_SECRET=sec_webhook_signing_secret_here

# ── PUBLIC APP URLS ────────────────────────────────────────────────────────
WEB_PUBLIC_URL=https://links.mcomsolutions.com