# Base URL of the MCOM Links backend API.
# Local dev: http://localhost:6007 | Production: https://<your-backend-domain>
VITE_API_URL=http://localhost:6007

# Port for the Vite dev server (defaults to 6004).
VITE_DEV_PORT=6004

# Set to 'true' to use the in-browser mock API (full offline testing, no backend required).
VITE_USE_MOCK=false

# MCOM Solutions (Central) Stripe publishable key used to render the in-app card
# checkout. Use Central's key (merchant of record); it matches the clientSecret
# returned by /api/v1/mcom/packages/purchase/initiate.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx